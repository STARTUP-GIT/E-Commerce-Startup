{
  "expo": {
    "name": "Atlas Basket Seller",
    "slug": "seller-mobile-app",
    "version": "1.0.0",
    "scheme": "atlasbasket-seller",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlasbasket.seller"
    },
    "android": {
      "package": "com.atlasbasket.seller",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#07070a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Atlas Basket Seller accesses your photos to allow uploading product images and shop documents."
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "17f7a36f-ed44-41e8-91d6-7375596fd695"
      }
    }
  }
}
