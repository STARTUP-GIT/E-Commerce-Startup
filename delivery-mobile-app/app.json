{
  "expo": {
    "name": "AtlasBasket Delivery",
    "slug": "atlasbasket-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "atlasbasket-delivery",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AtlasBasket Delivery uses your location to update dispatch and help navigate to deliveries."
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlasbasket.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AtlasBasket Delivery uses your location to show delivery and navigation details."
      }
    },
    "android": {
      "package": "com.atlasbasket.delivery",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "userInterfaceStyle": "dark"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9930183e-f0a1-412d-857f-2d0afa558eb7"
      }
    }
  }
}
