# Platform backend API URL (rewrites /api/platform/* to this host)
PLATFORM_BACKEND_API_URL=https://e-commerce-startup-backend.onrender.com

# NextAuth (JWT session for the platform UI)
NEXTAUTH_SECRET=super-secret-platform-nextauth-secret-change-me
NEXTAUTH_URL=http://localhost:8004

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
