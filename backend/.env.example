# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development

# ============================================================================
# Database (PostgreSQL — Neon recommended)
# ============================================================================
# DATABASE_URL: used by the app at runtime. For Neon this MUST be the
# POOLED connection string (host contains `-pooler`), e.g.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# The pooler is a PgBouncer-style transaction pool that Prisma Client can use.
#
# DIRECT_URL: used ONLY by Prisma Migrate / CLI (validate, generate, migrate
# deploy, studio). For Neon this MUST be the DIRECT connection string from the
# "Direct Connection" tab in Neon — the SAME host WITHOUT the `-pooler` segment:
#   postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Do NOT use the pooled URL as DIRECT_URL — migrations fail (P1002 advisory
# lock errors) through the pooler.
#
# Both are REQUIRED for `prisma migrate deploy` to succeed. In local
# development, if DIRECT_URL is omitted the runtime falls back to DATABASE_URL;
# in production the app fails fast with a clear message instead.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# Auth
# ============================================================================
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-string
CUSTOMER_SESSION_SECRET=replace-with-a-long-random-hex-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# Payments (PAYMENT_GATEWAY=RAZORPAY or PHONEPE)
# ============================================================================
PAYMENT_GATEWAY=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=

# ============================================================================
# Email (Resend)
# ============================================================================
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
APP_NAME=Aura Marketplace

# ============================================================================
# Frontend origins (comma-separated for CORS)
# ============================================================================
CUSTOMER_FRONTEND_URL=https://customer.example.com
SELLER_FRONTEND_URL=https://seller.example.com
ADMIN_FRONTEND_URL=https://admin.example.com
PLATFORM_FRONTEND_URL=https://platform.example.com
CORS_ORIGINS=https://customer.example.com,https://seller.example.com,https://admin.example.com,https://platform.example.com

# ============================================================================
# Cloudinary (image storage)
# ============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ============================================================================
# Optional S3 storage (only needed if using AWS S3 for uploads)
# ============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=
# S3_BUCKET_NAME=

# ============================================================================
# Delivery provider (DELIVERY_PROVIDER=PORTER)
# ============================================================================
DELIVERY_PROVIDER=PORTER
PORTER_API_KEY=
PORTER_API_URL=https://api.porter.in
PORTER_WEBHOOK_SECRET=

# ============================================================================
# Docker compose ports (optional overrides — NOT used on Render)
# ============================================================================
POSTGRES_DB=marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
CUSTOMER_API_PORT=3001
SELLER_API_PORT=3002
ADMIN_API_PORT=3003
PLATFORM_API_PORT=3006
DELIVERY_API_PORT=3004
PAYMENT_API_PORT=3005
