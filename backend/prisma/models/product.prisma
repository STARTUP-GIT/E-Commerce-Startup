model Product {
  id              String             @id @default(cuid())
  sellerId        String
  categoryId      String?
  name            String             @db.VarChar(300)
  slug            String?            @db.VarChar(320)
  description     String?
  sku             String?            @db.VarChar(100)
  price           Decimal            @db.Decimal(12, 2)
  hsnCode         String?            @db.VarChar(10)
  taxRate         Decimal?           @db.Decimal(5, 2)
  taxCategory     TaxCategory?       @default(TAXABLE)
  isTaxInclusive  Boolean            @default(false)
  taxReviewStatus String             @default("APPROVED") @db.VarChar(30)
  status          ProductStatus      @default(ACTIVE)
  stockQuantity   Int                @default(0)
  fulfilmentType  FulfilmentType     @default(READY_TO_SHIP)
  minPrepDays     Int?
  maxPrepDays     Int?
  prepTimeType    PrepTimeType?      @default(BUSINESS_DAYS)
  productionNotes String?
  maxConcurrentOrders Int?
  activeProductionOrders Int           @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean            @default(false)
  imageUrl        String?            @db.VarChar(2048)
  cartItems       CartItem[]
  inventoryLogs   InventoryLog[]
  orderItems      OrderItem[]
  attributes      ProductAttribute[]
  images          ProductImage[]
  reports         ProductReport[]
  variants        ProductVariant[]
  category        Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seller          Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  returnItems     ReturnRequest[]
  reviews         Review[]
  wishlistItems   WishlistItem[]

  @@unique([sellerId, sku])
  @@unique([sellerId, slug])
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}
