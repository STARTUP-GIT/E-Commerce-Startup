enum AdminAccountStatus {
  ACTIVE
  PENDING_INVITATION
  PENDING_APPROVAL
  SUSPENDED
  DISABLED
  EXPIRED
}

enum AdminInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum EmailChangeStatus {
  PENDING
  VERIFIED
  EXPIRED
  CANCELLED
}

model AdminInvitation {
  id          String                @id @default(cuid())
  email       String                @db.VarChar(320)
  fullName    String?               @db.VarChar(150)
  phone       String?               @db.VarChar(20)
  roleId      String?               @db.VarChar(30)
  roleName    String                @default("ADMIN") @db.VarChar(60)
  tokenHash   String                @unique @db.VarChar(255)
  invitedById String                @db.VarChar(30)
  status      AdminInvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  adminRole AdminRole? @relation(fields: [roleId], references: [id])
  invitedBy Admin      @relation("AdminInvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("admin_invitations")
}

model AdminAccessRequest {
  id           String              @id @default(cuid())
  email        String              @db.VarChar(320)
  googleId     String?             @db.VarChar(255)
  firstName    String?             @db.VarChar(100)
  lastName     String?             @db.VarChar(100)
  avatarUrl    String?             @db.VarChar(2048)
  status       AccessRequestStatus @default(PENDING)
  expiresAt    DateTime
  reviewedById String?             @db.VarChar(30)
  reviewedAt   DateTime?
  reviewNotes  String?             @db.VarChar(500)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  reviewedBy Admin? @relation("AccessRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("admin_access_requests")
}

model AdminEmailChange {
  id           String            @id @default(cuid())
  adminId      String            @db.VarChar(30)
  currentEmail String            @db.VarChar(320)
  newEmail     String            @db.VarChar(320)
  tokenHash    String            @unique @db.VarChar(255)
  status       EmailChangeStatus @default(PENDING)
  expiresAt    DateTime
  verifiedAt   DateTime?
  createdAt    DateTime          @default(now())

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([tokenHash])
  @@index([status])
  @@map("admin_email_changes")
}
