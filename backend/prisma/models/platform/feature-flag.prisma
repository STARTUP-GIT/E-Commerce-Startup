// =============================================================================
// FeatureFlag — the most important Platform module.
// Enables/disables/schedules/rolls-out features across the whole software
// platform WITHOUT requiring a new deployment.
// =============================================================================

model FeatureFlag {
  id                String            @id @default(cuid())
  key               String            @unique @db.VarChar(80)
  type              FeatureFlagType
  displayName       String            @db.VarChar(120)
  description       String?           @db.Text
  enabled           Boolean           @default(false)
  status            FeatureFlagStatus @default(DISABLED)
  scope             FeatureFlagScope  @default(GLOBAL)
  rolloutPercentage Int               @default(100)
  targetEnvironment String?           @db.VarChar(50)
  scheduledAt       DateTime?
  startsAt          DateTime?
  endsAt            DateTime?
  metadata          Json?
  createdBy         String?           @db.VarChar(80)
  updatedBy         String?           @db.VarChar(80)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([scope])
  @@index([enabled])
  @@map("feature_flags")
}
