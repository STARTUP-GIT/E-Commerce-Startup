// =============================================================================
// PlatformRole — RBAC role for Platform users. System roles are seeded
// (OWNER, ADMINISTRATOR, DEVELOPER, DEVOPS). Custom roles allowed.
// =============================================================================

model PlatformRole {
  id          String             @id @default(cuid())
  name        String             @unique @db.VarChar(80)
  description String?            @db.Text
  type        PlatformRoleType   @default(CUSTOM)
  isSystem    Boolean            @default(false)
  permissions PlatformPermission[] @relation("PlatformRolePermissions")
  users       PlatformUser[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type])
  @@map("platform_roles")
}
