// Marketplace-wide business configuration (GST, platform fee, packing rules,
// payment gateway, order parameters) stored as a single JSON blob.
//
// Row id = 1 is the live business configuration and MUST be preserved.
// Historically this table was also used to hold the removed Platform app's
// branding/UI-layout blob (row id = 2); that row was migrated into
// `marketplace_branding` and deleted — see migration
// 20261006000000_remove_platform_add_admin_rbac.
model MarketplaceSetting {
  id        Int      @id @default(1)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("marketplace_settings")
}
