model City {
  id                      String        @id @default(cuid())
  name                    String        @unique @db.VarChar(100)
  state                   String        @default("Karnataka") @db.VarChar(100)
  isActive                Boolean       @default(true)
  displayName             String?       @db.VarChar(100)
  description             String?
  launchStatus            String        @default("LAUNCHED") // LAUNCHED, COMING_SOON, PLANNED, MAINTENANCE
  isCustomerEnabled       Boolean       @default(true)
  isSellerEnabled         Boolean       @default(true)
  isDeliveryEnabled       Boolean       @default(true)
  maintenanceMode         Boolean       @default(false)
  displayOrder            Int           @default(0)
  comingSoonMessage       String?
  launchAnnouncement      String?
  expectedLaunchDate      DateTime?
  bannerUrl               String?
  allowCustomerBrowsing   Boolean       @default(true)
  allowCustomerOrdering   Boolean       @default(true)
  allowSellerRegistration Boolean       @default(true)
  allowShopCreation       Boolean       @default(true)
  customerNoticeMessage   String?
  sellerNoticeMessage     String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  cityTowns               CityTown[]
  serviceAreas            ServiceArea[]

  @@index([name])
  @@index([state])
  @@index([isActive])
  @@index([launchStatus])
  @@map("cities")
}
